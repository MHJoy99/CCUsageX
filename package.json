{
  "name": "ccusagex",
  "version": "1.0.0",
  "description": "Local, zero-dependency web dashboard for Claude Code usage: every prompt, request, model, token, cache hit and API-equivalent cost, read from Claude Code's own logs.",
  "main": "server.js",
  "bin": {
    "ccusagex": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "demo": "node scripts/demo-data.js .demo --serve",
    "test": "node --test test/server.test.js test/live.test.js",
    "verify": "node test/verify.js --live",
    "build:demo": "node scripts/build-pages-demo.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "server.js",
    "config.json",
    "public/",
    "CCUsageX.ps1",
    "Open-CCUsageX.cmd",
    "Close-CCUsageX.cmd",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "usage",
    "dashboard",
    "token-usage",
    "cost-tracker",
    "llm-cost",
    "ai-usage",
    "analytics",
    "prompt-caching",
    "developer-tools",
    "local-first",
    "zero-dependency"
  ],
  "homepage": "https://mhjoy99.github.io/CCUsageX/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MHJoy99/CCUsageX.git"
  },
  "bugs": {
    "url": "https://github.com/MHJoy99/CCUsageX/issues"
  },
  "author": "MHJoy99",
  "license": "MIT"
}
